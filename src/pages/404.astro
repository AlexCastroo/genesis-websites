---
import DisplayTitle from '../components/ui/DisplayTitle.astro';
import Pill from '../components/ui/Pill.astro';
import { mainNav, navHref } from '../config/nav';
import { defaultLocale, isMultilingual, localeCodes, locales } from '../i18n/config';
import { localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/404"
  title={t('notFound.title')}
  description={t('meta.notFound.description')}
  alternates={{}}
  noindex
>
  <div class="container container--narrow section-pad not-found">
    <Pill dot>{t('notFound.eyebrow')}</Pill>
    <DisplayTitle
      level={1}
      size="hero"
      align="center"
      title={t('notFound.title')}
      accent={t('notFound.accent')}
    />
    <p class="lead">{t('notFound.lead')}</p>
    <p class="eyebrow">{t('notFound.links')}</p>
    <ul role="list" class="not-found__links">
      {mainNav.map((item) => (
        <li>
          <a href={navHref(item, lang, '')} class="btn btn--secondary">
            {t(item.label)}
          </a>
        </li>
      ))}
      {isMultilingual &&
        localeCodes
          .filter((code): boolean => code !== lang)
          .map((code) => (
            <li>
              <a
                href={localizePath('home', code)}
                hreflang={locales[code].hreflang}
                lang={locales[code].hreflang}
                class="btn btn--secondary"
              >
                {locales[code].label}
              </a>
            </li>
          ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    text-align: center;
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2xs);
  }
</style>
