---
import CtaBand from '../components/blocks/CtaBand.astro';
import FeatureGrid from '../components/blocks/FeatureGrid.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import { SITE } from '../config/site';
import { localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { entrySlug } from '../lib/content';
import { getServices } from '../lib/queries';
import { breadcrumbNode, webPageNode, type Crumb } from '../lib/schema';
import type { ViewProps } from './types';

type Props = ViewProps;

const { lang, path, alternates } = Astro.props;
const t = useTranslations(lang);
const services = await getServices(lang);
const title = t('meta.services.title');
const description = t('meta.services.description');
const crumbs: Crumb[] = [
  { name: t('nav.home'), path: localizePath('home', lang) },
  { name: t('nav.services'), path },
];
const schema = [
  webPageNode(SITE, {
    path,
    type: 'CollectionPage',
    name: title,
    description,
    lang,
    hasBreadcrumb: true,
  }),
  breadcrumbNode(SITE, path, crumbs),
];
---

<BaseLayout
  lang={lang}
  path={path}
  title={title}
  description={description}
  alternates={alternates}
  schema={schema}
>
  <PageHeader lang={lang} crumbs={crumbs} title={t('services.title')} lead={t('services.lead')} />
  <div class="container section-pad">
    <FeatureGrid
      headingLevel={2}
      items={services.map((service) => ({
        title: service.data.title,
        text: service.data.summary,
        href: localizePath('services', lang, entrySlug(service.id)),
      }))}
    />
  </div>
  <CtaBand lang={lang} />
</BaseLayout>
