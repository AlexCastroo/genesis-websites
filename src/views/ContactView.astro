---
import ContactForm from '../components/blocks/ContactForm.astro';
import ContactInfo from '../components/blocks/ContactInfo.astro';
import PageHeader from '../components/blocks/PageHeader.astro';
import { SITE } from '../config/site';
import { localizePath, useTranslations } from '../i18n/utils';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbNode, webPageNode, type Crumb } from '../lib/schema';
import type { ViewProps } from './types';

type Props = ViewProps;

const { lang, path, alternates } = Astro.props;
const t = useTranslations(lang);
const title = t('meta.contact.title');
const description = t('meta.contact.description');
const crumbs: Crumb[] = [
  { name: t('nav.home'), path: localizePath('home', lang) },
  { name: t('nav.contact'), path },
];
const schema = [
  webPageNode(SITE, {
    path,
    type: 'ContactPage',
    name: title,
    description,
    lang,
    hasBreadcrumb: true,
  }),
  breadcrumbNode(SITE, path, crumbs),
];
const hasForm = Boolean(import.meta.env.PUBLIC_CONTACT_ENDPOINT);
---

<BaseLayout
  lang={lang}
  path={path}
  title={title}
  description={description}
  alternates={alternates}
  schema={schema}
>
  <PageHeader
    lang={lang}
    crumbs={crumbs}
    eyebrow={t('contact.eyebrow')}
    title={t('contact.title')}
    accent={t('contact.accent')}
    lead={t('contact.lead')}
  />
  <div class:list={['container contact-grid', { 'contact-grid--single': !hasForm }]}>
    <section class="contact-card" aria-labelledby="contact-info-title">
      <h2 id="contact-info-title" class="contact-card__title">
        {t('contact.info.title')}
      </h2>
      <ContactInfo lang={lang} />
    </section>
    {hasForm && (
      <div class="contact-card contact-card--form">
        <ContactForm lang={lang} />
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--space-m);
    padding-block-end: var(--space-2xl);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.2fr;
    }

    .contact-grid--single {
      grid-template-columns: minmax(0, 36rem);
    }
  }

  .contact-card {
    padding: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    background: var(--color-bg-subtle);
    border-radius: var(--radius-xl);
  }

  .contact-card--form {
    background: var(--color-bg-muted);
  }

  .contact-card__title {
    margin-block-end: var(--space-l);
    font-size: var(--step-2);
    font-weight: var(--fw-regular);
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .contact-card--form :global(h2) {
    font-size: var(--step-2);
    font-weight: var(--fw-regular);
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .contact-card--form :global(input:not([type='checkbox'])),
  .contact-card--form :global(textarea) {
    background: var(--color-surface);
    border-color: transparent;
    border-radius: var(--radius-md);
  }

  .contact-card--form :global(input:not([type='checkbox'])) {
    border-radius: var(--radius-full);
  }
</style>
