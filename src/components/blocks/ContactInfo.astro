---
import { SITE } from '../../config/site';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { formatOpeningDays } from '../../lib/hours';
import { whatsappLink } from '../../lib/whatsapp';
import Icon from '../ui/Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { contact, address, openingHours } = SITE;
const phoneHref = contact.phone ? `tel:${contact.phone.replace(/[^\d+]/g, '')}` : undefined;
const whatsappHref = contact.whatsapp
  ? whatsappLink(contact.whatsapp, t('whatsapp.general'))
  : undefined;
const addressText = address
  ? [address.street, `${address.postalCode} ${address.locality}`].join(', ')
  : undefined;
const mapHref = addressText
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${SITE.name}, ${addressText}`)}`
  : undefined;
const hours = (openingHours ?? []).map((slot) => ({
  days: formatOpeningDays(slot.days, (day) => t(`days.${day}`), {
    to: t('common.to'),
    and: t('common.and'),
  }),
  time: `${slot.opens} – ${slot.closes}`,
}));
---

<address class="contact-info">
  <dl>
    {whatsappHref && (
      <div>
        <dt>
          <span class="icon-circle">
            <Icon name="whatsapp" />
          </span>
          {t('contact.whatsapp')}
        </dt>
        <dd>
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            data-track="contact_whatsapp"
          >
            {t('cta.whatsapp')}
            <span class="visually-hidden"> {t('a11y.newTab')}</span>
          </a>
        </dd>
      </div>
    )}
    {phoneHref && (
      <div>
        <dt>
          <span class="icon-circle">
            <Icon name="phone" />
          </span>
          {t('contact.phone')}
        </dt>
        <dd>
          <a href={phoneHref} data-track="contact_phone">
            {contact.phone}
          </a>
        </dd>
      </div>
    )}
    <div>
      <dt>
        <span class="icon-circle">
          <Icon name="mail" />
        </span>
        {t('contact.email')}
      </dt>
      <dd>
        <a href={`mailto:${contact.email}`} data-track="contact_email">
          {contact.email}
        </a>
      </dd>
    </div>
    {addressText && (
      <div>
        <dt>
          <span class="icon-circle">
            <Icon name="map-pin" />
          </span>
          {t('contact.address')}
        </dt>
        <dd>
          {addressText}
          <br />
          <a href={mapHref} target="_blank" rel="noopener noreferrer">
            {t('contact.map')}
            <span class="visually-hidden"> {t('a11y.newTab')}</span>
          </a>
        </dd>
      </div>
    )}
    {hours.length > 0 && (
      <div>
        <dt>
          <span class="icon-circle">
            <Icon name="clock" />
          </span>
          {t('contact.hours')}
        </dt>
        <dd>
          <ul role="list">
            {hours.map((slot) => (
              <li>
                {slot.days}: {slot.time}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )}
  </dl>
</address>

<style>
  .contact-info {
    font-style: normal;
  }

  dl {
    display: grid;
    gap: var(--space-m);
  }

  dl > div {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--space-s);
  }

  dt {
    display: contents;
    font-weight: var(--fw-medium);
  }

  dt :global(.icon-circle) {
    grid-row: span 2;
  }

  dd {
    grid-column: 2;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  dd a {
    color: var(--color-text);
  }
</style>
