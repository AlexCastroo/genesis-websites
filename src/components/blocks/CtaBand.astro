---
import { SITE } from '../../config/site';
import type { Lang } from '../../i18n/config';
import { localizePath, useTranslations } from '../../i18n/utils';
import { getTrialPlan } from '../../lib/queries';
import { whatsappLink } from '../../lib/whatsapp';
import DisplayTitle from '../ui/DisplayTitle.astro';
import Icon from '../ui/Icon.astro';

interface Action {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  lang: Lang;
  eyebrow?: string;
  title?: string;
  accent?: string;
  lead?: string;
  primary?: Action;
  secondary?: Action;
  notes?: string[];
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const trial = await getTrialPlan();
const {
  eyebrow = t('ctaBand.eyebrow'),
  title = t('ctaBand.title'),
  accent = t('ctaBand.accent'),
  lead = t('ctaBand.lead'),
  primary = {
    label: t('cta.trialPrice', { price: trial.data.price }),
    href: `${localizePath('pricing', lang)}#solicitud`,
  },
  secondary = SITE.contact.whatsapp
    ? {
        label: t('cta.whatsapp'),
        href: whatsappLink(SITE.contact.whatsapp, t('whatsapp.general')),
        external: true,
      }
    : undefined,
  notes = [t('ctaBand.note1'), t('ctaBand.note2')],
} = Astro.props;
const externalAttrs = { target: '_blank', rel: 'noopener noreferrer' };
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-band__card">
      <DisplayTitle
        id="cta-band-title"
        level={2}
        size="card"
        tone="inverse"
        eyebrow={eyebrow}
        title={title}
        accent={accent}
      />
      <p class="cta-band__lead">{lead}</p>
      <div class="cluster cta-band__actions">
        <a
          href={primary.href}
          class="btn btn--light"
          data-track="cta_band"
          {...(primary.external ? externalAttrs : {})}
        >
          {primary.label}
        </a>
        {secondary && (
          <a
            href={secondary.href}
            class="btn btn--ghost-light"
            data-track="cta_band_secondary"
            {...(secondary.external ? externalAttrs : {})}
          >
            {secondary.label}
            {secondary.external && <span class="visually-hidden"> {t('a11y.newTab')}</span>}
          </a>
        )}
      </div>
      {notes.length > 0 && (
        <ul role="list" class="cluster cta-band__notes">
          {notes.map((note) => (
            <li>
              <Icon name="check-circle" size={16} /> {note}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--space-2xl);
  }

  .cta-band__card {
    position: relative;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    overflow: hidden;
    padding: clamp(2rem, 1rem + 5vw, 5rem);
    color: var(--color-text-inverse);
    background: var(--color-bg-inverse);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  /* Warm glow, decorative */
  .cta-band__card::before,
  .cta-band__card::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(60px);
  }

  .cta-band__card::before {
    top: -30%;
    left: 20%;
    width: 22rem;
    height: 22rem;
    background: rgb(117 88 68 / 0.55);
  }

  .cta-band__card::after {
    right: -10%;
    bottom: -40%;
    width: 26rem;
    height: 26rem;
    background: rgb(74 59 50 / 0.9);
  }

  .cta-band__lead {
    max-width: 52ch;
    font-weight: var(--fw-light);
    line-height: var(--lh-relaxed);
    color: var(--color-text-inverse-muted);
  }

  .cta-band__actions {
    --cluster-gap: var(--space-xs);
  }

  .cta-band__notes {
    --cluster-gap: var(--space-2xs) var(--space-m);
    font-size: var(--step--1);
    color: var(--color-text-inverse-muted);
  }

  .cta-band__notes li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  @media (max-width: 599px) {
    .cta-band__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
