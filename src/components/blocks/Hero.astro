---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Button from '../ui/Button.astro';

interface Action {
  label: string;
  href: string;
  track?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  primary: Action;
  secondary?: Action;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, primary, secondary, image, imageAlt = '' } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id="hero-title">{title}</h1>
      <p class="lead">{lead}</p>
      <div class="cluster hero__actions">
        <Button href={primary.href} track={primary.track}>
          {primary.label}
        </Button>
        {secondary && (
          <Button href={secondary.href} variant="secondary" track={secondary.track}>
            {secondary.label}
          </Button>
        )}
      </div>
    </div>
    {image && (
      <Picture
        src={image}
        alt={imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 900px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__image"
      />
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--section-gap);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .hero__content {
    display: grid;
    gap: var(--space-s);
  }

  .hero__actions {
    margin-block-start: var(--space-xs);
  }

  @media (max-width: 599px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }
  }

  .hero :global(.hero__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
</style>
