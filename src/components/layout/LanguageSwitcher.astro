---
import { isMultilingual, localeCodes, locales, type Lang } from '../../i18n/config';
import { localizePath, useTranslations, type Alternates } from '../../i18n/utils';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
// A page without a translation links to that language's home instead of a 404.
const links = localeCodes.map((code) => ({
  code,
  href: alternates[code] ?? localizePath('home', code),
  current: code === lang,
}));
---

{
  isMultilingual && (
    <nav class="lang-switcher" aria-label={t('a11y.langSwitcher')}>
      <ul role="list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              hreflang={locales[link.code].hreflang}
              lang={locales[link.code].hreflang}
              aria-current={link.current ? 'page' : undefined}
            >
              {locales[link.code].label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  ul {
    display: flex;
    gap: var(--space-xs);
  }

  a {
    font-size: var(--step--1);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  a[aria-current='page'] {
    color: var(--color-text);
    font-weight: var(--fw-bold);
  }
</style>
