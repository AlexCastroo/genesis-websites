{
  "name": "genesis-web-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/gen-nginx-redirects.ts",
    "preview": "astro preview",
    "check": "astro check && tsx scripts/check-i18n.ts && vitest run",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test": "vitest run",
    "verify": "tsx scripts/verify-dist.ts",
    "format": "prettier --write .",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
