# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty = no analytics and no cookie banner.
PUBLIC_GA_ID=
# URL that receives contact form POSTs (Formspree, n8n, own API...). Empty = no form, contact details only.
PUBLIC_CONTACT_ENDPOINT=
# Optional override of the CSP origin for the form. Derived from PUBLIC_CONTACT_ENDPOINT at build time.
CONTACT_ORIGIN=
